{
  "name": "onramp",
  "version": "0.1.0",
  "private": true,
  "description": "A GitHub App that watches your project's contributor funnel and nudges it back into motion when it stalls.",
  "author": "Bryandero98",
  "license": "MIT",
  "homepage": "https://github.com/Bryandero98/onramp",
  "keywords": [
    "probot",
    "github-app",
    "open-source",
    "maintainers",
    "contributor-experience"
  ],
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "probot run ./lib/index.js",
    "start": "probot run ./lib/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.33.0",
    "js-yaml": "^4.1.0",
    "probot": "^13.3.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nock": "^13.5.5",
    "prettier": "^3.3.3",
    "smee-client": "^2.0.4",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">= 18"
  }
}
