# GitHub App credentials - generate these when you register the app at
# https://github.com/settings/apps/new (see README.md for the exact settings).
APP_ID=
PRIVATE_KEY_PATH=./private-key.pem
WEBHOOK_SECRET=development

# Local webhook delivery while developing - get a URL from https://smee.io/new
WEBHOOK_PROXY_URL=

# Where onramp keeps its funnel-tracking database. Defaults to ./onramp.db.
ONRAMP_DB_PATH=./onramp.db

# How often (ms) onramp sweeps every installed repo for stale items. Defaults
# to one hour; lower it locally if you want to see a sweep run without waiting.
ONRAMP_SWEEP_INTERVAL_MS=3600000
